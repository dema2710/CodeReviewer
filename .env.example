# === Обов'язково ===
# Ключ DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-ваш-ключ-тут

# === Необов'язково ===
# Порт сервера (за замовчуванням 3000)
PORT=3000

# Модель DeepSeek (deepseek-chat = DeepSeek-V3, deepseek-reasoner = R1)
DEEPSEEK_MODEL=deepseek-chat

# Base URL API (можна змінити на власний проксі)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GitHub токен — підвищує ліміт запитів (60 -> 5000/год) і відкриває приватні репо
# Створити: https://github.com/settings/tokens
GITHUB_TOKEN=
